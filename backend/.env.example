# ===== 运行环境 =====
APP_ENV=development                 # development | staging | production
HTTP_ADDR=:8080
LOG_LEVEL=info
MIGRATE_ON_START=true

# ===== 数据库 =====
# 使用 docker compose 时：postgres://wmc:wmc_local_password@localhost:5432/wmc?sslmode=disable
# 使用本地 devdb 时：postgres://wmc:wmc_local_password@localhost:55432/wmc?sslmode=disable
DATABASE_URL=postgres://wmc:wmc_local_password@localhost:55432/wmc?sslmode=disable

# ===== 本地 devdb（无 Docker 环境）=====
EMBEDDED_PG=false
EMBEDDED_PG_PORT=55432
EMBEDDED_PG_DATA_DIR=.data/pg
PG_BINARY_REPO=https://maven.aliyun.com/repository/public

# ===== Redis（为空则使用内存实现）=====
REDIS_URL=
RATE_LIMIT_STORE=auto               # redis | memory | auto

# ===== 认证与安全（生产必须替换）=====
JWT_SECRET=
PHONE_HASH_SECRET=
PHONE_ENC_KEY=                      # base64 编码的 32 字节密钥
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ===== 短信 =====
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456
SMS_RESEND_INTERVAL=60s
SMS_DAILY_LIMIT=5

# ===== 对象存储 =====
STORAGE_DRIVER=fs                   # fs | s3
STORAGE_FS_ROOT=.data/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PUBLIC_URL=

# ===== 管理端开发登录（生产必须关闭）=====
ADMIN_DEV_LOGIN_ENABLED=true
